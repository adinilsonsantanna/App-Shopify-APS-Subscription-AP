DATABASE_URL=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=
SHOPIFY_APP_URL=
SHOP_CUSTOM_DOMAIN=
API_SUBSCRIPTION_URL=
API_KEY=
# Feature gate server-side para reconciliacao LIVE. Somente "true" habilita.
# Nunca enviada ao navegador. Ausente/vazio/false/invalido => live desabilitado.
ADMIN_BILLING_RECONCILIATION_LIVE_ENABLED=
# Allowlist server-side de alvos LIVE (JSON array). Vazio/ausente => nenhum alvo.
# Cada item: { "shop", "subscriptionContractId", "subscriptionBillingAttemptId",
# "shopifyOrderId", "cycleOriginTime", "correlationId" }. O browser nao decide alvo.
ADMIN_RECONCILIATION_LIVE_TARGETS=
# Secret server-to-server usado pela App ao chamar o endpoint live da Central.
# Nunca enviado ao navegador. Deve casar com ADMIN_RECONCILIATION_LIVE_SECRET da Central.
ADMIN_RECONCILIATION_LIVE_SECRET=
ENABLE_LEGACY_SUBSCRIPTION_FLOW=
